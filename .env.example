# Backend (export these variables in your shell, or use Docker Compose)
DATABASE_URL=sqlite:///./substigraph.db
GRAPH_BACKEND=networkx
SEMANTIC_MODE=tfidf
EMBEDDING_MODEL=all-MiniLM-L6-v2
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Frontend build only: VITE_API_URL=https://your-api.example.com/api
# Vercel full-stack project: set DATABASE_URL to your hosted PostgreSQL URL.
# Leave VITE_API_URL unset so the frontend uses the same-origin /api routes.
